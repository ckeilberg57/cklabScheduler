# Test environment variable names — copy to .env.test and fill in values if needed.
#
# These variables are generated automatically at pytest startup (see tests/conftest.py
# _ensure_test_environment()).  You only need this file if you want to supply
# specific values from CI or a developer override instead of the auto-generated ones.
#
# DO NOT put real credentials here.  These variables exist only for the test suite.

# Flask session signing key used during tests.
TEST_SECRET_KEY=

# Password used when creating synthetic test users in the test database.
TEST_USER_PASSWORD=
