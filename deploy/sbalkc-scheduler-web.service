[Unit]
Description=SBALKC Scheduler Web Application
After=network.target

[Service]
Type=simple
User=sbalkcscheduler
Group=sbalkcscheduler
WorkingDirectory=/opt/sbalkcScheduler
EnvironmentFile=/etc/sbalkcScheduler/sbalkcScheduler.env
ExecStart=/opt/sbalkcScheduler/venv/bin/gunicorn \
    --bind 127.0.0.1:5080 \
    --workers 2 \
    --threads 4 \
    --worker-class gthread \
    --env SCRIPT_NAME=${URL_PREFIX} \
    --access-logfile - \
    --error-logfile - \
    wsgi:application
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sbalkc-scheduler-web

[Install]
WantedBy=multi-user.target
