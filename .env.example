# Pexip configuration
# Hostname of the Pexip management node (for /api/admin/status endpoint — web process only)
REG_STATUS_HOST=pexip-manager.example.com
# Hostname of the Pexip Conferencing Node / edge node (for /api/client endpoint — both processes)
COMMAND_HOST=pexip-edge.example.com
# Pexip management API credentials (used by web process for endpoint listing)
MGMT_USER=pexip-api-user
MGMT_PASS=change-me
# Set to true to verify TLS certificates. Per-host overrides available below.
VERIFY_TLS=true
# REG_VERIFY_TLS=true    # overrides VERIFY_TLS for REG_STATUS_HOST
# COMMAND_VERIFY_TLS=true # overrides VERIFY_TLS for COMMAND_HOST

# Scheduler / conference behaviour
HOST_PIN=
CONTROL_DISPLAY_NAME=Scheduler
DIAL_PROTOCOL=auto
ABOUT_TO_START_MINUTES=1
DEFAULT_EXTEND_MINUTES=15
POLL_SECONDS=3

# Pexip WebRTC join link base URL (constructed from COMMAND_HOST if left empty)
# WEBRTC_BASE_URL=https://pexip.example.com/webapp3/m/

# Flask session secret key (generate with: openssl rand -hex 32)
# Required by web process. Generated automatically by install.sh.
SECRET_KEY=

# Microsoft 365 email integration
O365_ENABLED=false
O365_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_FROM_MAILBOX=
O365_EMAIL_SUBJECT=Your Secure Virtual Consultation
O365_ORGANIZER_NAME=Pexip Scheduler
O365_LOCATION=Secure Virtual Session
O365_TIMEZONE=America/New_York
O365_INCLUDE_ICS=true
O365_ALLOW_PROPOSE_NEW_TIME=false
O365_SAVE_TO_SENT_ITEMS=true

# Database path (production default is /var/lib/cklabScheduler/scheduler.db)
# DB_PATH=/var/lib/cklabScheduler/scheduler.db
