# Pexip configuration
REG_STATUS_HOST=pexip-manager.example.com
COMMAND_HOST=pexip-edge.example.com
MGMT_USER=pexip-api-user
MGMT_PASS=change-me
VERIFY_TLS=true
HOST_PIN=
CONTROL_DISPLAY_NAME=Scheduler
DIAL_PROTOCOL=sip
POLL_SECONDS=5

# Microsoft 365 integration
O365_ENABLED=false
O365_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_FROM_MAILBOX=
O365_INCLUDE_ICS=true
O365_TIMEZONE=America/New_York
O365_ORGANIZER_NAME=
O365_LOCATION=
O365_ALLOW_PROPOSE_NEW_TIME=false

# Pexip WebRTC
WEBRTC_BASE_URL=https://pexip.example.com/webapp3/
