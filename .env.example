# ─────────────────────────────────────────────────────────────────────────────
# cklabScheduler — environment configuration template
#
# Copy this file to .env for local development.
# On a production server, values are written to /etc/cklabScheduler/cklabScheduler.env
# by deploy/install.sh.
#
# NEVER commit a file containing real credentials, tokens, or passwords.
# ─────────────────────────────────────────────────────────────────────────────

# ── Pexip API ─────────────────────────────────────────────────────────────────
# Hostname of the Pexip Management Node (registration status API — web process)
REG_STATUS_HOST=pexip-manager.example.com
# Hostname of the Pexip Conferencing Node / edge node (command API — both processes)
COMMAND_HOST=pexip-edge.example.com
# Pexip Management API credentials
MGMT_USER=pexip-api-user
MGMT_PASS=CHANGE_ME
# Set to true to verify Pexip TLS certificates (recommended for production)
VERIFY_TLS=true
# Per-host TLS overrides (uncomment to override VERIFY_TLS for a specific host)
# REG_VERIFY_TLS=true
# COMMAND_VERIFY_TLS=true

# ── Application display ───────────────────────────────────────────────────────
# Name shown in the browser tab title and sidebar heading.
# Independent of CONTROL_DISPLAY_NAME (Pexip participant name).
APP_DISPLAY_NAME=CKlabs Scheduler

# ── Conference behaviour ──────────────────────────────────────────────────────
# PIN sent as host when dialling endpoints into the VMR (leave blank for no PIN)
HOST_PIN=
# Display name of the scheduler's Pexip control participant
CONTROL_DISPLAY_NAME=Scheduler
# Dial protocol: sip, h323, or auto
DIAL_PROTOCOL=auto
# Minutes before meeting start to show "about to start" yellow status
ABOUT_TO_START_MINUTES=1
# Default meeting extension duration in minutes
DEFAULT_EXTEND_MINUTES=15
# Frontend polling interval in seconds
POLL_SECONDS=3

# ── WebRTC ────────────────────────────────────────────────────────────────────
# WebRTC join link base URL. Constructed from COMMAND_HOST if left blank.
# WEBRTC_BASE_URL=https://pexip.example.com/webapp3/m/

# ── Flask session ─────────────────────────────────────────────────────────────
# Flask session signing key. Generate with: openssl rand -hex 32
# The installer generates this automatically. Never commit a real value.
SECRET_KEY=

# ── Session cookies ───────────────────────────────────────────────────────────
# Set to false only for local HTTP development (must be true in production).
SESSION_COOKIE_SECURE=true

# ── Authentication ────────────────────────────────────────────────────────────
# Local administrator authentication.
# At least one of LOCAL_AUTH_ENABLED or ENTRA_ENABLED must be true.
LOCAL_AUTH_ENABLED=true

# Microsoft Entra ID / Azure AD authentication (optional).
# See docs/ENTRA_AUTHENTICATION.md for setup instructions.
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Leave blank to use the default public-cloud authority:
#   https://login.microsoftonline.com/<ENTRA_TENANT_ID>
ENTRA_AUTHORITY=
# Exact redirect URI registered in the Entra app registration.
# Example: https://scheduler.example.com/cklabScheduler/auth/callback
ENTRA_REDIRECT_URI=
# Where to send the browser after Microsoft logout (optional).
ENTRA_POST_LOGOUT_REDIRECT_URI=
# Entra app role values that map to scheduler roles.
ENTRA_REQUIRED_ADMIN_ROLE=Scheduler.Administrator
ENTRA_REQUIRED_USER_ROLE=Scheduler.User

# ── Microsoft 365 email integration ──────────────────────────────────────────
O365_ENABLED=false
# Azure AD tenant ID (GUID)
O365_TENANT_ID=00000000-0000-0000-0000-000000000000
# Azure AD application (client) ID (GUID)
O365_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Azure AD client secret value (from App registrations → Certificates & secrets)
O365_CLIENT_SECRET=CHANGE_ME
# Shared mailbox or user mailbox to send invitations from
O365_FROM_MAILBOX=scheduler@example.com
O365_EMAIL_SUBJECT=Your Secure Virtual Consultation
O365_ORGANIZER_NAME=Pexip Scheduler
O365_LOCATION=Secure Virtual Session
O365_TIMEZONE=America/New_York
O365_INCLUDE_ICS=true
O365_ALLOW_PROPOSE_NEW_TIME=false
O365_SAVE_TO_SENT_ITEMS=true

# ── Database ──────────────────────────────────────────────────────────────────
# Production default: /var/lib/cklabScheduler/scheduler.db
# Override for local development:
# DB_PATH=/tmp/scheduler-dev.db
